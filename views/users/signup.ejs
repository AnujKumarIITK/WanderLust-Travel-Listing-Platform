<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
    <h1 class="col-6 offset-3 text-center fw-bold mb-4">Sign Up for WanderLust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" novalidate class="needs-validation p-4 shadow rounded bg-white">

            <div class="mb-3">
                <label for="username" class="form-label fw-semibold">Username</label>
                <input name="username" id="username" placeholder="Enter your username" type="text" class="form-control" required>
                <div class="valid-feedback">Username looks good!</div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Email</label>
                <input name="email" id="email" placeholder="Enter your email" type="email" class="form-control" required>
                <div class="valid-feedback">Email looks good!</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label fw-semibold">Password</label>
                <input name="password" id="password" placeholder="Enter your password" type="password" class="form-control" required>
                <div class="valid-feedback">Password looks good!</div>
            </div>

            <button class="btn btn-success w-100 mt-3">Sign Up</button>

        </form>
    </div>
</div>

